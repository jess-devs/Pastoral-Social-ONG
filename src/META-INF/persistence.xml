<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence
                                 http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">

    <!--Una Unidad de persistencia(en caso de requerir otras se genera el mismo espacio de "persistence-unit"-->
    <persistence-unit name="PastoralSocialJPA">
        <provider>org.hibernate.ejb.HibernatePersistence</provider>

        <!-- Clases -->
        <class>com.ulatina.gestion.model.Adendum</class>
        <class>com.ulatina.gestion.model.AsistenciaEvento</class>
        <class>com.ulatina.gestion.model.AsistenciaSolicitada</class>
        <class>com.ulatina.gestion.model.DocumentoAdjunto</class>
        <class>com.ulatina.gestion.model.Entrevista</class>
        <class>com.ulatina.gestion.model.Evento</class>
        <class>com.ulatina.gestion.model.Expediente</class>
        <class>com.ulatina.gestion.model.GastoMensual</class>
        <class>com.ulatina.gestion.model.MiembroFamiliar</class>
        <class>com.ulatina.gestion.model.Parroquia</class>
        <class>com.ulatina.gestion.model.Persona</class>
        <class>com.ulatina.gestion.model.ProlongacionAyuda</class>
        <class>com.ulatina.gestion.model.Usuario</class>
        <class>com.ulatina.gestion.model.Vivienda</class>

        <properties>
            <!-- Datos de conexión — driver legacy compatible con Hibernate 3 -->
            <property name="hibernate.connection.driver_class" value="com.mysql.cj.jdbc.Driver"/>
            <property name="hibernate.connection.url"          value="jdbc:mysql://localhost:3306/pastoral_social?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true"/>
            <property name="hibernate.connection.username"     value="root"/>
            <property name="hibernate.connection.password"     value=""/>

            <!-- MySQL5InnoDBDialect es el más compatible con Hibernate 3 + MySQL 8 -->
            <property name="hibernate.dialect"        value="org.hibernate.dialect.MySQL5InnoDBDialect"/>
            <property name="hibernate.hbm2ddl.auto"   value="update"/>
            <property name="hibernate.show_sql"       value="true"/>
            <property name="hibernate.format_sql"     value="true"/>
        </properties>
    </persistence-unit>
    <!--Una Unidad de persistencia(en caso de requerir otras se genera el mismo espacio de "persistence-unit"-->

</persistence>
